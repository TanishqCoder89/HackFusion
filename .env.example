# =====================================================================
# NexaHire - environment variables (copy to .env, or enter in your host's dashboard)
# One service serves both the website and the API, so there is only one set of variables.
# =====================================================================

# ---------- REQUIRED ----------
NODE_ENV=production
# Public URL of the site, no trailing slash. Used for CORS and phone-camera links.
CLIENT_URL=https://nexahire.example.com
# Long random string (>= 32 chars). Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# MySQL 8 connection. Either one URL ...
DB_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# ... or the individual parts (ignored when DB_URL is set):
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=nexahire
# Set true for managed MySQL that requires TLS (Aiven, PlanetScale, Azure, RDS...)
DB_SSL=false

# ---------- AI INTERVIEW ROOM (needed for the live avatar interviewer) ----------
GROQ_API_KEY=
SECONDARY_GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- OPTIONAL: AI question generation for companies (set ONE) ----------
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---------- OPTIONAL: Google Cloud voice (natural TTS / STT) ----------
# Upload the service-account JSON to the server and point to it, or leave blank to use the browser voice.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# ---------- PHONE CAMERA (WebRTC) ----------
# TURN relay so phones on other networks can connect. Without it only simple networks work.
# Comma-separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------- OPTIONAL / PLATFORM ----------
# Port the server listens on (most hosts inject this automatically)
PORT=5000
# true when behind a proxy/load balancer (Render, Railway, Fly, nginx...). Correct client IPs for rate limiting.
TRUST_PROXY=true
# Create the demo accounts (alex@candidate.com / recruiter@techcorp.io, password123). Keep false in production.
SEED_DEMO_DATA=false
# Show demo quick-fill buttons on the login page (build-time, Frontend). Keep unset in production.
# VITE_SHOW_DEMO=false
