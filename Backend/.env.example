# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=jpassword
DB_NAME=ai_interview_db

# Security & JWT Configuration
JWT_SECRET=hackfusion_super_secure_jwt_secret_key_2026_interview_platform
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# AI question generation (set ONE; leave blank to disable the "Generate with AI" features)
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- AI avatar interviewer (the live Assessment Room) ---
GROQ_API_KEY=
SECONDARY_GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional Google Cloud voice (TTS/STT). Place the service-account JSON on the server and point to it:
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# --- Production / WebRTC phone camera ---
# Set to true when running behind nginx / Render / Railway / a load balancer
TRUST_PROXY=true
# TURN relay so the phone camera connects across different networks (STUN alone fails behind strict NATs).
# Comma-separated URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
